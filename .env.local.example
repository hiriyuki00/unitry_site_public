# コピーして `.env.local` にリネームし、値を埋めてください。
# Next.js は `.env.local.example` を自動では読みません。

# お問い合わせ（種別ごとに Google フォームの回答用 URL）
NEXT_PUBLIC_GOOGLE_FORM_VOLUNTEER=
NEXT_PUBLIC_GOOGLE_FORM_SPONSOR=
NEXT_PUBLIC_GOOGLE_FORM_OTHER=

# Google Analytics 4 測定 ID（取得後に設定してください）
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# CAMPFIRE クラウドファンディング URL（プロジェクト公開後に設定）
# 注意: CAMPFIRE は iframe 埋め込みを拒否するため、ご支援ページでは新規タブで開くリンクになります。
NEXT_PUBLIC_CAMPFIRE_URL=

# note（Unitry のプロフィール URL。未設定時は https://note.com/）
NEXT_PUBLIC_NOTE_URL=https://note.com/ab_unitry24

# サイト URL（Vercel デプロイ後に設定）
SITE_URL=https://unitry.vercel.app
